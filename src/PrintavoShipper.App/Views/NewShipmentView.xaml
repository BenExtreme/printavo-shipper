<UserControl x:Class="PrintavoShipper.App.Views.NewShipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:coremodels="clr-namespace:PrintavoShipper.Core.Models;assembly=PrintavoShipper.Core"
             mc:Ignorable="d">
    <ScrollViewer x:Name="LeftScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16" MaxWidth="640" HorizontalAlignment="Left">
            <ui:TextBlock Text="New Shipment" Style="{StaticResource PageHeaderTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Ship a one-off address — not tied to any particular order unless you link one below."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}" />

            <!-- Link to Printavo order (optional) -->
            <ui:TextBlock Text="Printavo Order (optional)" Style="{StaticResource SectionHeaderTextStyle}" />
            <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                <StackPanel>
                    <TextBlock Text="Linking writes tracking + cost as one Printavo Task line (assigned as set under Settings &gt; Printavo Workflow), instead of a customer-note tracking line."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding LinkedOrder, Converter={StaticResource InverseNullToVisConverter}}">
                        <ui:TextBox Width="140" Text="{Binding LinkedOrderVisualIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Content="Look up" Command="{Binding LookupOrderCommand}" Margin="8,0,0,0" Padding="8,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding OrderLookupErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding OrderLookupErrorMessage, Converter={StaticResource StringToVisConverter}}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding LinkedOrder, Converter={StaticResource NullToVisConverter}}">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Linked to Order #" />
                            <Run Text="{Binding LinkedOrder.VisualId, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" — " />
                            <Run Text="{Binding LinkedOrder.CustomerCompanyName, Mode=OneWay}" />
                        </TextBlock>
                        <ui:Button Content="Clear" Appearance="Secondary" Command="{Binding ClearLinkedOrderCommand}" Margin="8,0,0,0" Padding="8,4" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Carrier -->
            <ui:TextBlock Text="Carrier" Style="{StaticResource SectionHeaderTextStyle}" />
            <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="UPS" GroupName="NewShipmentCarrier" Margin="0,0,20,0" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedCarrier, Converter={StaticResource CarrierToBoolConverter}, ConverterParameter=Ups}" />
                    <RadioButton Content="FedEx" GroupName="NewShipmentCarrier" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedCarrier, Converter={StaticResource CarrierToBoolConverter}, ConverterParameter=FedEx}" />
                </StackPanel>
            </ui:Card>

            <!-- Ship-to address -->
            <ui:TextBlock Text="Ship-To Address" Style="{StaticResource SectionHeaderTextStyle}" />
            <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                <StackPanel>
                    <ui:TextBlock Text="Name / Company" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.NameMaxLength}" Margin="0,0,0,6"
                             Text="{Binding ShipToName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="Attention name (optional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.AttentionNameMaxLength}" Margin="0,0,0,6"
                             Text="{Binding ShipToAttentionName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="Address line 1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.AddressLineMaxLength}" Margin="0,0,0,6"
                             Text="{Binding ShipToAddress1, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="Address line 2 (optional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.AddressLineMaxLength}" Margin="0,0,0,6"
                             Text="{Binding ShipToAddress2, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="City" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.CityMaxLength}" Margin="0,0,0,6"
                             Text="{Binding ShipToCity, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,8,0">
                            <ui:TextBlock Text="State" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Width="60" MaxLength="{x:Static coremodels:UpsAddressLimits.StateProvinceCodeMaxLength}"
                                     Text="{Binding ShipToState, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <ui:TextBlock Text="Postal code" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Width="80" MaxLength="{x:Static coremodels:UpsAddressLimits.PostalCodeMaxLength}"
                                     Text="{Binding ShipToPostalCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:TextBlock Text="Country" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Width="55" MaxLength="{x:Static coremodels:UpsAddressLimits.CountryCodeLength}"
                                     Text="{Binding ShipToCountryCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:TextBlock Text="Phone (optional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.PhoneNumberMaxLength}" Margin="0,0,0,8"
                             Text="{Binding ShipToPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Content="Add Shipment" Appearance="Primary" Command="{Binding AddShipmentCommand}"
                            HorizontalAlignment="Left" Padding="10,5" FontWeight="Bold" />
                </StackPanel>
            </ui:Card>

            <!-- Shipment cards -->
            <StackPanel Visibility="{Binding ShipmentCards.Count, Converter={StaticResource CountToVisConverter}}">
                <ui:TextBlock Text="Shipments" Style="{StaticResource SectionHeaderTextStyle}" />
                <ItemsControl x:Name="ShipmentCardsList" ItemsSource="{Binding ShipmentCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
