<UserControl x:Class="PrintavoShipper.App.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:behaviors="clr-namespace:PrintavoShipper.App.Behaviors"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}" />
            <TextBlock Text="Loading..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />
        </StackPanel>

        <Grid Grid.Row="1" Visibility="{Binding Order, Converter={StaticResource NullToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="35*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: everything except the Printavo Status changer and Production Note -->
            <ScrollViewer x:Name="LeftScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:TextBlock Text="{Binding Order.VisualId, StringFormat='Order #{0}'}" Style="{StaticResource PageHeaderTextStyle}" Margin="0" />
                        <emoji:TextBlock Text="{Binding Order.StatusName, Converter={StaticResource EmojiDisplayTextConverter}}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="12,0,0,4" />
                    </StackPanel>
                    <!-- Total + balance: some customers' orders don't ship until paid, so the balance is called out in red. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock FontSize="14">
                            <Run Text="Total:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding Order.Total, StringFormat='{}{0:C}', Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="·" FontSize="14" Margin="10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding Order.HasBalanceDue, Converter={StaticResource BoolToVisConverter}}">
                            <Run Text="Balance due:" />
                            <Run Text="{Binding Order.AmountOutstanding, StringFormat='{}{0:C}', Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Text="Paid in full" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding Order.HasBalanceDue, Converter={StaticResource InverseBoolToVisConverter}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Order.Nickname}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,4" FontSize="13">
                        <Run Text="For:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding Order.CustomerCompanyName, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <StackPanel Visibility="{Binding IsPickup, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="{Binding ShopName, StringFormat='Direct customer (not imported as a contractor) — shipping from {0} by default.'}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                                   Visibility="{Binding Contractor, Converter={StaticResource InverseNullToVisConverter}}" />
                    </StackPanel>
                    <TextBlock Text="Pick-up order — no shipping label needed." FontSize="12" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding IsPickup, Converter={StaticResource BoolToVisConverter}}" />

                    <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding ShowContractorSetupBanner, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="This contractor doesn't have a ship-from address or billing accounts set up yet."
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ui:Button Content="Set up this contractor" Appearance="Secondary" Command="{Binding ConfigureContractorCommand}"
                                    Margin="16,0,0,0" Padding="10,4" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding ShowUnrecognizedDeliveryMethodWarning, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Unrecognized delivery method" FontWeight="Bold" />
                            <Run Text="{Binding DeliveryMethodName, StringFormat=' &quot;{0}&quot;', Mode=OneWay}" />
                            <Run Text="{Binding DefaultCarrierName, StringFormat=' — defaulting to {0} shipping.', Mode=OneWay}" />
                            <Run Text="Double-check this order's delivery method in Printavo if that's not right, or add the name under Settings &gt; Printavo Workflow &gt; Delivery methods." />
                        </TextBlock>
                    </ui:Card>

                    <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding ShowShipFromNotConfiguredWarning, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="No shop ship-from address" FontWeight="Bold" />
                            <Run Text=" — fill in Settings &gt; Default Ship-From Address before shipping for a direct customer, or the carrier will reject the label." />
                        </TextBlock>
                    </ui:Card>

                    <ui:TextBlock Text="Customer Note" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                        <RichTextBox IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="0" Background="Transparent"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     behaviors:HtmlFlowDocumentBehavior.Html="{Binding Order.CustomerNoteHtml}" />
                    </ui:Card>

                    <!-- Pick-up orders: box labels instead of ship-to addresses/shipment cards. -->
                    <StackPanel Visibility="{Binding IsPickup, Converter={StaticResource BoolToVisConverter}}">
                        <ui:TextBlock Text="Box Labels" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                            <StackPanel>
                                <ui:TextBlock Text="Number of boxes" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox Width="120" Minimum="1" Maximum="99" ClearButtonEnabled="False" Value="{Binding BoxCount, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Content="Print Box Labels" Appearance="Primary" Command="{Binding PrintBoxLabelsCommand}"
                                               Padding="12,6" Margin="10,0,0,0" FontWeight="Bold" VerticalAlignment="Stretch" />
                                </StackPanel>
                                <TextBlock Text="{Binding BoxLabelLogoSource}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="Printing..." Margin="0,6,0,0"
                                           Visibility="{Binding IsPrintingBoxLabels, Converter={StaticResource BoolToVisConverter}}" />
                                <TextBlock Text="{Binding BoxLabelMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding BoxLabelMessage, Converter={StaticResource StringToVisConverter}}" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPickup, Converter={StaticResource InverseBoolToVisConverter}}">
                        <ui:TextBlock Text="Ship-To Address" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                            <StackPanel>
                                <ui:TextBlock Text="Default (from Printavo order)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Order.ShippingAddress.CompanyName, Mode=OneWay}" FontWeight="Bold" /><LineBreak />
                                    <Run Text="{Binding Order.ShippingAddress.CustomerName, Mode=OneWay}" /><LineBreak />
                                    <Run Text="{Binding Order.ShippingAddress.Address1, Mode=OneWay}" /> <Run Text="{Binding Order.ShippingAddress.Address2, Mode=OneWay}" /><LineBreak />
                                    <Run Text="{Binding Order.ShippingAddress.City, Mode=OneWay}" />, <Run Text="{Binding Order.ShippingAddress.State, Mode=OneWay}" /> <Run Text="{Binding Order.ShippingAddress.ZipCode, Mode=OneWay}" />
                                </TextBlock>
                                <ui:Button Content="Ship this address" Appearance="Secondary" Command="{Binding ShipDefaultAddressCommand}"
                                        HorizontalAlignment="Left" Padding="8,4" Margin="0,10,0,0" />
                            </StackPanel>
                        </ui:Card>
    
                        <StackPanel Visibility="{Binding CustomAddresses.Count, Converter={StaticResource CountToVisConverter}}">
                            <ui:TextBlock Text="Additional Ship-To Addresses" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ItemsControl ItemsSource="{Binding CustomAddresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding CompanyName, Mode=OneWay}" FontWeight="Bold" /><LineBreak />
                                                    <Run Text="{Binding CustomerName, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="{Binding Address1, Mode=OneWay}" /> <Run Text="{Binding Address2, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="{Binding City, Mode=OneWay}" />, <Run Text="{Binding State, Mode=OneWay}" /> <Run Text="{Binding ZipCode, Mode=OneWay}" />
                                                </TextBlock>
                                                <ui:Button Content="Ship this address" Appearance="Secondary" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.ShipCustomAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
    
                        <StackPanel Visibility="{Binding ShipmentCards.Count, Converter={StaticResource CountToVisConverter}}">
                            <ui:TextBlock Text="Shipments" Style="{StaticResource SectionHeaderTextStyle}" />
                            <ItemsControl x:Name="ShipmentCardsList" ItemsSource="{Binding ShipmentCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right column: Printavo Status changer and Production Note, pinned to the top of the window -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Printavo: status changer + Add Task (a Task on this order assigned to a user — used to tell the order's CSR about overages/shortages), combined in one card to save room. -->
                <StackPanel Grid.Row="0">
                    <ui:TextBlock Text="Printavo" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ui:Card Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}">
                        <StackPanel>
                            <ui:TextBlock Text="Status" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,6,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <emoji:TextBlock Text="{Binding Name, Converter={StaticResource EmojiDisplayTextConverter}}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ui:Button Grid.Column="1" Content="Update" Appearance="Secondary" Command="{Binding UpdateStatusCommand}"
                                           Padding="10,4" VerticalAlignment="Stretch" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding StatusUpdateMessage, Converter={StaticResource StringToVisConverter}}">
                                <emoji:TextBlock Text="{Binding StatusUpdateMessage, Converter={StaticResource EmojiDisplayTextConverter}}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Separator Margin="0,12,0,10" />

                            <ui:TextBlock Text="Add Task" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Text="{Binding TaskDetails, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="e.g. Overage: 3 extra L Black tees" TextWrapping="Wrap" AcceptsReturn="False"
                                        MaxLength="255" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding TaskAssigneeOptions}" SelectedItem="{Binding SelectedTaskAssignee}"
                                          DisplayMemberPath="Name" ToolTip="Assign to" Margin="0,0,6,0" />
                                <ui:Button Grid.Column="1" Content="Add Task" Appearance="Secondary" Command="{Binding AddTaskCommand}"
                                           Padding="10,4" VerticalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Text="{Binding TaskStatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding TaskStatusMessage, Converter={StaticResource StringToVisConverter}}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <ui:TextBlock Grid.Row="1" Text="Production Note" Style="{StaticResource SectionHeaderTextStyle}" />
                <ui:Card Grid.Row="2" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                         Padding="{StaticResource ContentCardPadding}" Margin="{StaticResource ContentCardMargin}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                    <RichTextBox IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="0" Background="Transparent"
                                 VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 behaviors:HtmlFlowDocumentBehavior.Html="{Binding Order.ProductionNoteHtml}" />
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
