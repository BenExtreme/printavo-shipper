<ui:FluentWindow x:Class="PrintavoShipper.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Printavo Shipper" Height="720" Width="1100"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="/Resources/AppIcon.ico">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateToOrdersCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateToContractorsCommand}" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateToHistoryCommand}" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateToSettingsCommand}" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateToNewShipmentCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <ui:TitleBar Title="Printavo Shipper" DockPanel.Dock="Top">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/AppIcon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="RootNavigationView" Grid.Column="0"
                                PaneDisplayMode="Left" IsPaneToggleVisible="True"
                                OpenPaneLength="200">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Orders" Icon="{ui:SymbolIcon ShoppingBag24}" Tag="Orders"
                                            Command="{Binding NavigateToOrdersCommand}" />
                    <ui:NavigationViewItem Content="New Shipment" Icon="{ui:SymbolIcon Send24}" Tag="NewShipment"
                                            Command="{Binding NavigateToNewShipmentCommand}" />
                    <ui:NavigationViewItem Content="Contractors" Icon="{ui:SymbolIcon People24}" Tag="Contractors"
                                            Command="{Binding NavigateToContractorsCommand}" />
                    <ui:NavigationViewItem Content="History" Icon="{ui:SymbolIcon History24}" Tag="History"
                                            Command="{Binding NavigateToHistoryCommand}" />
                    <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" Tag="Settings"
                                            Command="{Binding NavigateToSettingsCommand}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="16" />
        </Grid>
    </DockPanel>
</ui:FluentWindow>
