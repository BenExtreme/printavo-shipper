<UserControl x:Class="PrintavoShipper.App.Views.ShipmentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <DockPanel>
        <ui:TextBlock DockPanel.Dock="Top" Text="Shipment History" Style="{StaticResource PageHeaderTextStyle}" />

        <ui:Card DockPanel.Dock="Top" Padding="{StaticResource SearchBarCardPadding}" Margin="{StaticResource SearchBarCardMargin}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBox x:Name="SearchBox" Width="260" PlaceholderText="Order #, tracking #, or company..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Content="Search" Appearance="Secondary" Command="{Binding SearchCommand}" Margin="8,0,24,0" Padding="12,4" />
                <CheckBox Content="Needs Printavo sync only" IsChecked="{Binding NeedsSyncOnly}" VerticalAlignment="Center" />
            </StackPanel>
        </ui:Card>

        <Border DockPanel.Dock="Top" Height="28" Margin="0,0,0,8" ClipToBounds="True">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Top"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" VerticalAlignment="Top"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}" />
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Loading..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontStyle="Italic" Margin="0,0,0,8"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />

        <ui:DataGrid x:Name="ShipmentsGrid" ItemsSource="{Binding ShipmentsView}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="False" RowHeight="34" RowDetailsVisibilityMode="Collapsed"
                  PreviewMouseWheel="ShipmentsGrid_PreviewMouseWheel"
                  MouseDoubleClick="ShipmentsGrid_MouseDoubleClick"
                  ContextMenuOpening="ShipmentsGrid_ContextMenuOpening">
            <!-- Opened manually from ShipmentsGrid_ContextMenuOpening rather than assigned to
                 DataGrid.ContextMenu: wpf-ui's cells carry their own Copy/Cut/Paste menu, which
                 sits deeper in the right-click route than the grid and so always wins over a
                 grid-level ContextMenu. The handler suppresses that and opens this one with its
                 DataContext set to the right-clicked row's ShipmentRecord. -->
            <DataGrid.Resources>
                <ContextMenu x:Key="ShipmentRowContextMenu">
                    <MenuItem Header="Copy Master Tracking Number" Icon="{ui:SymbolIcon Copy24}"
                              IsEnabled="{Binding HasTrackingNumber, Mode=OneWay}" Click="CopyMasterTrackingNumber_Click" />
                    <MenuItem Header="Copy All Tracking Numbers" Icon="{ui:SymbolIcon DocumentCopy24}"
                              IsEnabled="{Binding HasTrackingNumber, Mode=OneWay}" Click="CopyAllTrackingNumbers_Click" />
                </ContextMenu>
            </DataGrid.Resources>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding TrackedPackages}" Margin="40,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="80" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding PackageIndex, Mode=OneWay, StringFormat='Package {0}'}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding TrackingNumber, Mode=OneWay}" />
                                    <TextBlock Text=" (master)" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PackageIndex}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:Button Icon="{ui:SymbolIcon Copy24}" Appearance="Transparent" Padding="4" Margin="6,0,0,0"
                                               ToolTip="Copy this tracking number"
                                               Command="{Binding DataContext.CopyTrackingNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding TrackingNumber}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <!-- A plain GroupStyle.HeaderTemplate can't hide/show the group's rows, only
                         decorate a header that sits above them, so making groups actually
                         collapsible needs a full GroupItem.Template replacement: an Expander
                         wrapping the header content around the group's own ItemsPresenter.
                         IsExpanded must stay Mode=OneWay — it binds TwoWay by default (same as
                         Run.Text, CLAUDE.md gotcha #8) and CollectionViewGroup.Name has no
                         setter; the Expander's own toggle still works interactively afterward
                         since WPF's internal toggle uses SetCurrentValue, not SetValue. -->
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="{Binding Name, Mode=OneWay, Converter={StaticResource DateIsTodayToBoolConverter}}">
                                            <Expander.Header>
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock FontWeight="Bold">
                                                        <Run Text="{Binding Name, Mode=OneWay, StringFormat='dddd, MMMM d, yyyy'}" />
                                                        <Run FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Text="{Binding ItemCount, Mode=OneWay, Converter={StaticResource ItemCountToShipmentsLabelConverter}}" />
                                                    </TextBlock>
                                                </Border>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <!-- Expand chevron for multi-package shipments: toggles the row's own
                     DetailsVisibility (the grid's RowDetailsVisibilityMode is Collapsed, and a
                     row's local DetailsVisibility overrides that). TwoWay is deliberate here —
                     DataGridRow.DetailsVisibility is a settable DP, unlike gotchas #3/#8. -->
                <DataGridTemplateColumn Width="32" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChevronToggleButtonStyle}" ToolTip="Show all tracking numbers"
                                          IsChecked="{Binding DetailsVisibility, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource VisibilityToBoolConverter}}"
                                          Visibility="{Binding HasMultipleTrackingNumbers, Converter={StaticResource BoolToVisConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Order #" Binding="{Binding PrintavoVisualId}" Width="70" />
                <DataGridTextColumn Header="Ship To" Binding="{Binding ShipToCompanyName}" Width="180" />
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceLevelName}" Width="110" />
                <DataGridTextColumn Header="Tracking" Binding="{Binding FirstTrackingNumber}" Width="150" />
                <DataGridTextColumn Header="Cost" Binding="{Binding TotalCost, StringFormat={}{0:C}}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                <DataGridTextColumn Header="Shipped" Binding="{Binding LocalCreatedAt, StringFormat={}{0:M/d/yy h:mm tt}}" Width="120" />
                <DataGridCheckBoxColumn Header="Needs Sync" Binding="{Binding NeedsPrintavoWriteBack, Mode=OneWay}" Width="80" />
                <DataGridTemplateColumn Header="Actions" Width="420">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Open Order" Appearance="Secondary" Padding="6,2" Margin="0,0,4,0" FontSize="11"
                                        Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <ui:Button Content="Reprint" Appearance="Secondary" Padding="6,2" Margin="0,0,4,0" FontSize="11"
                                        Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Status, Converter={StaticResource PurchasedStatusToVisConverter}}" />
                                <ui:Button Content="Retry Sync" Appearance="Caution" Padding="6,2" Margin="0,0,4,0" FontSize="11"
                                        Command="{Binding DataContext.RetryPrintavoSyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding NeedsPrintavoWriteBack, Converter={StaticResource BoolToVisConverter}}" />
                                <ui:Button Content="Void" Appearance="Danger" Padding="6,2" FontSize="11"
                                        Command="{Binding DataContext.VoidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Status, Converter={StaticResource PurchasedStatusToVisConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>
    </DockPanel>
</UserControl>
