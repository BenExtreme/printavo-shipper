<UserControl x:Class="PrintavoShipper.App.Views.FedExShipmentCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PrintavoShipper.App.ViewModels"
             xmlns:coremodels="clr-namespace:PrintavoShipper.Core.Models;assembly=PrintavoShipper.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="ui:TextBox" x:Key="PkgBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style TargetType="ui:TextBlock" x:Key="AddressValidationText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AddressValidationHasWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ui:TextBox" x:Key="BillingFormFieldStyle" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Width" Value="140" />
        </Style>
    </UserControl.Resources>

    <ui:Card Padding="14" Margin="0,0,0,14">
        <ui:Card.InputBindings>
            <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding ShipCommand}" />
        </ui:Card.InputBindings>
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0" Style="{StaticResource ChevronToggleButtonStyle}" Margin="-4,0,4,0" VerticalAlignment="Center"
                              ToolTip="Expand / collapse this shipment" IsChecked="{Binding IsExpanded}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShipToLabel}" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="FedEx" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,2,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Remove" Appearance="Secondary" Command="{Binding RemoveCommand}" Padding="8,3" FontSize="11"
                        Visibility="{Binding Result, Converter={StaticResource InverseNullToVisConverter}}" />
            </Grid>
            <!-- No own account at all: the carrier rejects any shipment without one, even third-party billed -->
            <ui:Card Visibility="{Binding ShowNoOwnAccountWarning, Converter={StaticResource BoolToVisConverter}}"
                     Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                     BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1"
                     Padding="10" Margin="0,4,0,8">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Add your own FedEx account before shipping." FontWeight="Bold" />
                    <Run Text=" FedEx requires your own account as the shipper, even when a third party pays. Add one under Settings &gt; Our FedEx Accounts, then reopen this order." />
                </TextBlock>
            </ui:Card>
            <!-- Collapsed: one summary line in place of the whole card body -->
            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisConverter}}">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,0,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Result, Converter={StaticResource NullToVisConverter}}">
                    <Run Text="{Binding Result.Status, StringFormat='Shipment {0}', Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" · " />
                    <Run Text="{Binding Result.ServiceLevelName, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Result.FirstTrackingNumber, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConverter}}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ShipToSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                <ui:Button Grid.Column="1" Content="Edit Address" Appearance="Secondary" Command="{Binding EditShipToCommand}" Padding="6,1" FontSize="10" VerticalAlignment="Top">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEditShipTo}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditingShipTo}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:TextBlock Text="{Binding AddressValidationStatus}" Style="{StaticResource AddressValidationText}" MaxWidth="320"
                              Visibility="{Binding AddressValidationStatus, Converter={StaticResource StringToVisConverter}}" />
                <ui:Button Content="Re-check" Appearance="Secondary" Command="{Binding ValidateAddressCommand}" Padding="6,1" FontSize="10"
                        Margin="8,0,0,0" VerticalAlignment="Top"
                        Visibility="{Binding Result, Converter={StaticResource InverseNullToVisConverter}}" />
            </StackPanel>
            <TextBlock Text="{Binding ReferenceNumbersDisplay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,0,12" />

            <!-- Manual ship-to correction, for when Printavo's address is wrong or won't validate -->
            <ui:Card Visibility="{Binding IsEditingShipTo, Converter={StaticResource BoolToVisConverter}}"
                     Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                     BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1"
                     Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Correct Ship-To Address" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />
                    <ui:TextBlock Text="Name / Company" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.NameMaxLength}" Margin="0,0,0,6"
                             Text="{Binding EditShipToName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="Attention name (optional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.AttentionNameMaxLength}" Margin="0,0,0,6"
                             Text="{Binding EditShipToAttentionName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="Address line 1" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.AddressLineMaxLength}" Margin="0,0,0,6"
                             Text="{Binding EditShipToAddress1, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="Address line 2 (optional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.AddressLineMaxLength}" Margin="0,0,0,6"
                             Text="{Binding EditShipToAddress2, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBlock Text="City" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.CityMaxLength}" Margin="0,0,0,6"
                             Text="{Binding EditShipToCity, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,8,0">
                            <ui:TextBlock Text="State" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Width="60" MaxLength="{x:Static coremodels:UpsAddressLimits.StateProvinceCodeMaxLength}"
                                     Text="{Binding EditShipToState, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <ui:TextBlock Text="Postal code" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Width="80" MaxLength="{x:Static coremodels:UpsAddressLimits.PostalCodeMaxLength}"
                                     Text="{Binding EditShipToPostalCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <ui:TextBlock Text="Country" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                            <ui:TextBox Width="55" MaxLength="{x:Static coremodels:UpsAddressLimits.CountryCodeLength}"
                                     Text="{Binding EditShipToCountryCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:TextBlock Text="Phone (optional)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2" />
                    <ui:TextBox MaxLength="{x:Static coremodels:UpsAddressLimits.PhoneNumberMaxLength}" Margin="0,0,0,8"
                             Text="{Binding EditShipToPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Save Address" Appearance="Secondary" Command="{Binding SaveShipToEditsCommand}" Padding="8,4" Margin="0,0,8,0" FontWeight="Bold" />
                        <ui:Button Content="Cancel" Appearance="Secondary" Command="{Binding CancelEditShipToCommand}" Padding="8,4" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Pre-ship editing area -->
            <StackPanel Visibility="{Binding Result, Converter={StaticResource InverseNullToVisConverter}}">
                <ui:TextBlock Text="Ship From" Style="{StaticResource FieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding ShipFromOptions}" SelectedItem="{Binding SelectedShipFrom}" Margin="0,0,0,2">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type coremodels:ContractorShipFromAddress}">
                            <StackPanel Margin="0,2,0,2">
                                <TextBlock>
                                    <Run>
                                        <Run.Text>
                                            <MultiBinding Converter="{StaticResource LabelOrDefaultConverter}">
                                                <Binding Path="Label" Mode="OneWay" />
                                                <Binding Path="IsDefault" Mode="OneWay" />
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                                <TextBlock Text="{Binding Converter={StaticResource ShipFromAddressToOneLineConverter}}"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SelectedShipFrom, Converter={StaticResource ShipFromAddressToOneLineConverter}}"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" TextWrapping="NoWrap" />

                <!-- Our account + service level share one row: neither needs the full card width. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="Our FedEx Account" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding OwnAccountOptions}" SelectedItem="{Binding SelectedOwnAccount}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock Text="Service Level" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding ServiceLevels}" SelectedItem="{Binding SelectedServiceLevel}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </Grid>

                <ui:TextBlock Text="Bill To" Style="{StaticResource FieldLabelTextStyle}" />
                <CheckBox Content="Bill third-party FedEx account" IsChecked="{Binding BillThirdParty}" Margin="0,0,0,6" />
                <StackPanel Visibility="{Binding BillThirdParty, Converter={StaticResource BoolToVisConverter}}">
                    <ComboBox ItemsSource="{Binding BillingAccountPickerOptions}" SelectedItem="{Binding SelectedBillingAccount}"
                              DisplayMemberPath="Label" Margin="0,0,0,4"
                              Visibility="{Binding HasSavedBillingAccounts, Converter={StaticResource BoolToVisConverter}}" />

                <StackPanel Visibility="{Binding ShowNewBillingAccountFields, Converter={StaticResource BoolToVisConverter}}">
                    <WrapPanel>
                        <ui:TextBox Style="{StaticResource BillingFormFieldStyle}" PlaceholderText="Label (optional)"
                                 Text="{Binding NewBillingLabel, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Style="{StaticResource BillingFormFieldStyle}" Width="100" PlaceholderText="Account Number"
                                 Text="{Binding NewBillingAccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Style="{StaticResource BillingFormFieldStyle}" Width="50" PlaceholderText="Country"
                                 MaxLength="{x:Static coremodels:UpsAddressLimits.CountryCodeLength}"
                                 Text="{Binding NewBillingCountryCode, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>

                    <CheckBox IsChecked="{Binding SaveBillingAccountToProfile}" Margin="0,0,0,4">
                        <TextBlock Text="{Binding BillingProfileDisplayName, StringFormat='Save this account to {0}\'s profile'}" TextWrapping="Wrap" />
                    </CheckBox>
                    <WrapPanel Visibility="{Binding SaveBillingAccountToProfile, Converter={StaticResource BoolToVisConverter}}">
                        <ui:TextBox Style="{StaticResource BillingFormFieldStyle}" Width="220" PlaceholderText="Notes (optional)"
                                 Text="{Binding NewBillingNotes, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Default" IsChecked="{Binding NewBillingIsDefault}" VerticalAlignment="Center" Margin="0,0,10,6" />
                    </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Billing on our own FedEx account." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,0,4"
                           Visibility="{Binding BillThirdParty, Converter={StaticResource InverseBoolToVisConverter}}" />

                <ui:TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabelTextStyle}" />
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                         PlaceholderText="e.g. DESIGN 1 &amp; DESIGN 2" />
                <TextBlock Text="Shown after the tracking number in the customer note, in parentheses." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,0,10" />

                <ui:TextBlock Text="Packages (box size / weight lbs / L / W / H in)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Packages}" AlternationCount="1000">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToRowNumberConverter}}" />
                                <ComboBox Grid.Column="1" Margin="0,0,6,0" Padding="4,3"
                                          ItemsSource="{x:Static vm:BoxSizePresets.All}"
                                          SelectedItem="{Binding SelectedBoxSize}" DisplayMemberPath="Name"
                                          ToolTip="Box size preset" />
                                <ui:TextBox Grid.Column="2" Style="{StaticResource PkgBox}" ToolTip="Weight (lbs)"
                                         Text="{Binding WeightLbs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" Text="lbs" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Grid.Column="4" Style="{StaticResource PkgBox}" ToolTip="Length (in)"
                                         Text="{Binding LengthIn, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox Grid.Column="5" Style="{StaticResource PkgBox}" ToolTip="Width (in)"
                                         Text="{Binding WidthIn, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:TextBox Grid.Column="6" Style="{StaticResource PkgBox}" ToolTip="Height (in)"
                                         Text="{Binding HeightIn, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="7" Content="Clone" Appearance="Secondary" Padding="6,2" Margin="0,0,4,0" FontSize="10"
                                        ToolTip="Add another package with the same size/weight"
                                        Command="{Binding DataContext.ClonePackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <ui:TextBox Grid.Column="8" Style="{StaticResource PkgBox}" ToolTip="Number of clones to add"
                                         Text="{Binding CloneCount, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="9" Content="✕" Appearance="Secondary" Padding="6,2"
                                        Command="{Binding DataContext.RemovePackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Content="+ Add Package" Appearance="Secondary" Command="{Binding AddPackageCommand}" Padding="8,3" FontSize="11"
                        HorizontalAlignment="Left" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:Button Content="Get Rates" Appearance="Secondary" Command="{Binding GetRatesCommand}" Padding="8,4" Margin="0,0,10,0" />
                    <ui:Button Content="Ship &amp; Print Label" Appearance="Success" Command="{Binding ShipCommand}" Padding="12,6" FontWeight="Bold" />
                    <TextBlock Text="Working..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>
                <TextBlock Text="{Binding ShipDisabledReason}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,0,8"
                           Visibility="{Binding ShipDisabledReason, Converter={StaticResource StringToVisConverter}}" />
                <TextBlock Text="{Binding RateOriginSummary}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding RateQuotes}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Padding="8,4" Margin="0,0,0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.ApplyRateQuoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <ui:Button.Appearance>
                                    <MultiBinding Converter="{StaticResource RateQuoteAppearanceConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.AppliedRateQuote" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </ui:Button.Appearance>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ServiceDescription}" FontWeight="Bold" />
                                    <TextBlock Text=" — " />
                                    <TextBlock Text="{Binding TotalCost, StringFormat='{}{0:C}'}" />
                                    <TextBlock Text=" (" />
                                    <TextBlock Text="{Binding BusinessDaysInTransit}" />
                                    <TextBlock Text=" business day(s))" />
                                </StackPanel>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Post-ship result area -->
            <ui:Card Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" Padding="10" Margin="0,0,0,4"
                    Visibility="{Binding Result, Converter={StaticResource NullToVisConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="{Binding Result.Status, StringFormat='Shipment {0}'}" />
                    <TextBlock Text="{Binding Result.FirstTrackingNumber, StringFormat='Tracking: {0}'}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Result.TotalCost, StringFormat='Cost: {0:C}'}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Result.ServiceLevelName}" Margin="0,2,0,0" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding Result.ReferenceNumber1, StringFormat='Ref 1 (PO): {0}', Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Result.ReferenceNumber2, StringFormat='Ref 2 (Invoice): {0}', Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Result.Notes, StringFormat='Notes: {0}', Mode=OneWay}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                               Visibility="{Binding Result.Notes, Converter={StaticResource StringToVisConverter}}" />
                    <TextBlock Text="{Binding PrintavoSyncStatus}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                               Visibility="{Binding PrintavoSyncStatus, Converter={StaticResource StringToVisConverter}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Reprint Label" Appearance="Secondary" Command="{Binding ReprintCommand}" Padding="8,4" Margin="0,0,8,0" />
                        <ui:Button Content="Void Shipment" Appearance="Danger" Command="{Binding VoidCommand}" Padding="8,4" Margin="0,0,8,0" />
                        <ui:Button Content="Retry Printavo Sync" Appearance="Secondary" Command="{Binding RetryPrintavoWriteBackCommand}" Padding="8,4"
                                Visibility="{Binding ShowPrintavoRetryButton, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                    <TextBlock Text="Working..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontStyle="Italic" Margin="0,6,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{Binding PrintWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding PrintWarning, Converter={StaticResource StringToVisConverter}}" />
            <TextBlock Text="{Binding PrintavoWriteBackWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding PrintavoWriteBackWarning, Converter={StaticResource StringToVisConverter}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}" />
            </StackPanel>
        </StackPanel>
    </ui:Card>
</UserControl>
